# --- обязательные -------------------------------------------------------

# Токен бота от @BotFather.
BOT_TOKEN=123456:AAEXAMPLE-token-from-botfather

# Telegram-идентификатор владельца: при первом старте он получает роль
# владельца и доступ к кабинету. Узнать свой id можно у @userinfobot.
OWNER_ID=123456789

# --- необязательные -----------------------------------------------------

# Путь к файлу SQLite. В docker-compose переопределяется на /data.
DB_PATH=data/quiz.sqlite3

# Уровень логирования: CRITICAL, ERROR, WARNING, INFO, DEBUG.
LOG_LEVEL=INFO

# Таймзона по умолчанию: по ней считаются сутки статистики и лимитов.
# Действующее значение меняется из кабинета и хранится в базе.
DEFAULT_TIMEZONE=Europe/Moscow
